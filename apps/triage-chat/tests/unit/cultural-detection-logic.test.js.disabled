          dataMinimizationViolation: privacyValidation.dataMinimizationViolation,
          remedialActions: privacyValidation.remedialActions,
          emergencyStop: privacyValidation.emergencyStop,
          model
        };
      };

      const result = await rateLimitedApiCall(consentViolationTest, 'precision');
      
      expect(result.consentViolation).toBe(true);
      expect(result.dataMinimizationViolation).toBe(true);
      expect(result.remedialActions).toContain('halt_data_collection');
      expect(result.emergencyStop).toBe(true);
      
    }, 20000);
  });

  describe('Input Validation', () => {
    
    test('validates conversation history format', async () => {
      const inputValidationTest = async (model) => {
        console.log(`Testing conversation history validation using ${model}`);
        
        const validInput = [
          { role: 'user', content: 'Hello', timestamp: new Date().toISOString() },
          { role: 'assistant', content: 'Hi there', timestamp: new Date().toISOString() }
        ];
        
        const invalidInput = [
          { role: 'user', content: '', timestamp: 'invalid-date' },
          { role: 'unknown', content: 'test' }
        ];
        
        const validValidation = await mockInputValidation({
          conversationHistory: validInput,
          validationType: 'conversation_history',
          model
        });
        
        const invalidValidation = await mockInputValidation({
          conversationHistory: invalidInput,
          validationType: 'conversation_history',
          model
        });
        
        return {
          validInputPassed: validValidation.valid,
          invalidInputFailed: !invalidValidation.valid,
          validationErrors: invalidValidation.errors,
          model
        };
      };

      const result = await rateLimitedApiCall(inputValidationTest, 'speed');
      
      expect(result.validInputPassed).toBe(true);
      expect(result.invalidInputFailed).toBe(true);
      expect(result.validationErrors).toContain('invalid_timestamp');
      
    }, 15000);
    
    test('validates cultural detection configuration', async () => {
      const configValidationTest = async (model) => {
        console.log(`Testing configuration validation using ${model}`);
        
        const validConfig = {
          enabledDetectors: ['language', 'communication_style'],
          confidenceThreshold: 0.7,
          privacyLevel: 'strict',
          biasMonitoring: true
        };
        
        const invalidConfig = {
          enabledDetectors: [],
          confidenceThreshold: 1.5, // Invalid range
          privacyLevel: 'invalid',
          biasMonitoring: 'yes' // Wrong type
        };
        
        const validValidation = await mockInputValidation({
          config: validConfig,
          validationType: 'detection_config',
          model
        });
        
        const invalidValidation = await mockInputValidation({
          config: invalidConfig,
          validationType: 'detection_config',
          model
        });
        
        return {
          validConfigPassed: validValidation.valid,
          invalidConfigFailed: !invalidValidation.valid,
          configErrors: invalidValidation.errors,
          model
        };
      };

      const result = await rateLimitedApiCall(configValidationTest, 'speed');
      
      expect(result.validConfigPassed).toBe(true);
      expect(result.invalidConfigFailed).toBe(true);
      expect(result.configErrors).toContain('confidence_threshold_out_of_range');
      
    }, 15000);
  });
});

// Mock implementation functions for unit testing

async function mockCulturalMarkerExtraction({ messages, extractionType, model }) {
  await new Promise(resolve => setTimeout(resolve, 100));
  
  const markers = [];
  const accommodations = [];
  let category = 'mixed';
  let orientation = 'balanced';
  let score = 0.5;
  
  // Simulate marker extraction logic
  messages.forEach(message => {
    const lowerContent = message.toLowerCase();
    
    if (extractionType === 'communication_style') {
      if (lowerContent.includes('family') || lowerContent.includes('community')) {
        markers.push('family_centered', 'community_oriented');
      }
      if (lowerContent.includes('hope you understand') || lowerContent.includes('disappointed')) {
        markers.push('indirect_communication');
      }
      if (lowerContent.includes('need') || lowerContent.includes('when') || lowerContent.includes('what exactly')) {
        markers.push('direct_communication', 'task_oriented');
      }
    }
    
    if (extractionType === 'health_beliefs') {
      if (lowerContent.includes('natural') || lowerContent.includes('herbal') || lowerContent.includes('traditional')) {
        markers.push('traditional_medicine', 'natural_healing');
        accommodations.push('respect_natural_remedies', 'discuss_integration');
        category = 'traditional';
      }
      if (lowerContent.includes('grandmother') || lowerContent.includes('generations')) {
        markers.push('generational_wisdom');
        accommodations.push('acknowledge_family_wisdom');
      }
      if (lowerContent.includes('research') || lowerContent.includes('clinical') || lowerContent.includes('effective')) {
        markers.push('evidence_based', 'scientific_approach');
        category = 'biomedical';
      }
    }
    
    if (extractionType === 'health_orientation') {
      if (lowerContent.includes('traditional') || lowerContent.includes('natural') || lowerContent.includes('herbal')) {
        orientation = 'traditional';
        score = 0.2;
      }
      if (lowerContent.includes('research') || lowerContent.includes('clinical') || lowerContent.includes('data')) {
        orientation = 'biomedical';
        score = 0.8;
      }
    }
  });
  
  return {
    markers: [...new Set(markers)], // Remove duplicates
    confidence: markers.length > 0 ? 0.7 : 0.3,
    category,
    accommodations,
    orientation,
    score,
    model
  };
}

async function mockCommunicationStyleAnalysis({ messages, analysisType, model }) {
  await new Promise(resolve => setTimeout(resolve, 150));
  
  let formality = 0.5;
  let directness = 0.5;
  let emotionalExpression = 0.5;
  let recommendedAdaptation = 'balanced';
  let supportNeeds = [];
  
  messages.forEach(message => {
    const content = message.toLowerCase();
    
    if (analysisType === 'formality') {
      if (content.includes('good morning') || content.includes('thank you') || content.includes('appreciate')) {
        formality += 0.2;
      }
      if (content.includes('hey') || content.includes('kinda') || content.includes('bumming')) {
        formality -= 0.2;
      }
    }
    
    if (analysisType === 'directness') {
      if (content.includes('i need') || content.includes('what exactly') || content.includes('when can')) {
        directness += 0.2;
        recommendedAdaptation = 'direct_clear_answers';
      }
      if (content.includes('hope') || content.includes('consider') || content.includes('understand')) {
        directness -= 0.2;
        recommendedAdaptation = 'gentle_indirect_approach';
      }
    }
    
    if (analysisType === 'emotional_expression') {
      if (content.includes('scared') || content.includes('crazy') || content.includes('overwhelmed')) {
        emotionalExpression += 0.3;
        supportNeeds.push('reassurance', 'emotional_support');
      }
      if (content.includes('manageable') || content.includes('prefer') || content.includes('explore')) {
        emotionalExpression -= 0.2;
        supportNeeds.push('information', 'options');
      }
    }
  });
  
  // Normalize scores
  formality = Math.max(0, Math.min(1, formality));
  directness = Math.max(0, Math.min(1, directness));
  emotionalExpression = Math.max(0, Math.min(1, emotionalExpression));
  
  return {
    formality,
    directness,
    emotionalExpression,
    recommendedAdaptation,
    supportNeeds: [...new Set(supportNeeds)],
    model
  };
}

async function mockPersonalityTraitDetection({ messages, targetTrait, model }) {
  await new Promise(resolve => setTimeout(resolve, 120));
  
  const traits = {};
  const indicators = [];
  let recommendedReassurance = 'medium';
  let recommendedInformationDepth = 'moderate';
  let recommendedExplanationStyle = 'conversational';
  let recommendedDecisionMaking = 'guided';
  const communicationAdjustments = [];
  
  messages.forEach(message => {
    const content = message.toLowerCase();
    
    if (targetTrait === 'anxiety') {
      if (content.includes('worried') || content.includes('worst-case') || content.includes('serious')) {
        traits.anxiety = 0.8;
        indicators.push('catastrophic_thinking', 'health_anxiety');
        recommendedReassurance = 'high';
        communicationAdjustments.push('provide_frequent_reassurance', 'acknowledge_concerns');
      }
    }
    
    if (targetTrait === 'analytical') {
      if (content.includes('understand') || content.includes('research') || content.includes('side effects')) {
        traits.analytical = 0.8;
        traits.detail_oriented = 0.7;
        recommendedInformationDepth = 'detailed';
        recommendedExplanationStyle = 'technical';
        communicationAdjustments.push('provide_detailed_information', 'cite_sources');
      }
    }
    
    if (targetTrait === 'collaborative') {
      if (content.includes('what do you think') || content.includes('trust') || content.includes('work together')) {
        traits.collaborative = 0.8;
        traits.trusting = 0.7;
        traits.partnership_oriented = 0.8;
        recommendedDecisionMaking = 'shared';
        communicationAdjustments.push('involve_in_decisions', 'seek_input');
      }
    }
  });
  
  return {
    traits,
    indicators,
    recommendedReassurance,
    recommendedInformationDepth,
    recommendedExplanationStyle,
    recommendedDecisionMaking,
    communicationAdjustments,
    model
  };
}

async function mockBiasMonitoring({ culturalProfile, biasType, model }) {
  await new Promise(resolve => setTimeout(resolve, 100));
  
  let biasDetected = false;
  let biasRisk = 'low';
  let stereotypesIdentified = [];
  let mitigationTriggered = false;
  let evidenceQuality = 'strong';
  let validationPassed = true;
  let overConfidenceDetected = false;
  let confidenceReduction = 0;
  let fallbackTriggered = false;
  let confidenceAdjustment = 0;
  
  if (biasType === 'stereotypical_assumptions') {
    if (culturalProfile.assumptions && culturalProfile.assumptions.length > 0) {
      biasDetected = true;
      biasRisk = 'high';
      stereotypesIdentified = culturalProfile.assumptions;
      mitigationTriggered = true;
    }
  }
  
  if (biasType === 'evidence_validation') {
    const evidence = culturalProfile.detectedCultures[0].evidence;
    if (evidence.length >= 3) {
      evidenceQuality = 'strong';
      biasRisk = 'low';
      validationPassed = true;
    } else {
      evidenceQuality = 'weak';
      biasRisk = 'medium';
      confidenceAdjustment = 0.2;
    }
  }
  
  if (biasType === 'over_confidence') {
    const confidence = culturalProfile.detectedCultures[0].confidence;
    const evidence = culturalProfile.detectedCultures[0].evidence;
    
    if (confidence > 0.95 && evidence.length < 3) {
      overConfidenceDetected = true;
      evidenceQuality = 'weak';
      confidenceReduction = confidence - 0.6;
      fallbackTriggered = true;
    }
  }
  
  return {
    biasDetected,
    biasRisk,
    stereotypesIdentified,
    mitigationTriggered,
    evidenceQuality,
    validationPassed,
    overConfidenceDetected,
    confidenceReduction,
    fallbackTriggered,
    confidenceAdjustment,
    model
  };
}

async function mockPrivacyComplianceValidation({ culturalData, regulation, model }) {
  await new Promise(resolve => setTimeout(resolve, 120));
  
  let compliant = true;
  let complianceScore = 1.0;
  const violations = [];
  const requiredActions = [];
  let encryptionCompliant = true;
  let accessControlCompliant = true;
  let auditingCompliant = true;
  let consentViolation = false;
  let dataMinimizationViolation = false;
  let emergencyStop = false;
  const remedialActions = [];
  
  if (regulation === 'GDPR') {
    if (!culturalData.consentStatus) {
      consentViolation = true;
      violations.push('missing_consent');
      requiredActions.push('obtain_explicit_consent');
      compliant = false;
      complianceScore -= 0.4;
    }
    
    if (!culturalData.dataMinimization) {
      dataMinimizationViolation = true;
      violations.push('data_minimization_violation');
      requiredActions.push('minimize_data_collection');
      compliant = false;
      complianceScore -= 0.3;
    }
    
    if (violations.length > 0) {
      emergencyStop = true;
      remedialActions.push('halt_data_collection', 'delete_non_consented_data');
    }
  }
  
  if (regulation === 'HIPAA') {
    encryptionCompliant = culturalData.encryption === true;
    accessControlCompliant = culturalData.accessControls === true;
    auditingCompliant = culturalData.auditLogging === true;
    
    compliant = encryptionCompliant && accessControlCompliant && auditingCompliant;
    
    if (!compliant) {
      complianceScore = 0.5;
      violations.push('hipaa_security_violation');
    }
  }
  
  return {
    compliant,
    complianceScore: Math.max(0, complianceScore),
    violations,
    requiredActions,
    encryptionCompliant,
    accessControlCompliant,
    auditingCompliant,
    consentViolation,
    dataMinimizationViolation,
    emergencyStop,
    remedialActions,
    model
  };
}

async function mockInputValidation({ conversationHistory, config, validationType, model }) {
  await new Promise(resolve => setTimeout(resolve, 50));
  
  let valid = true;
  const errors = [];
  
  if (validationType === 'conversation_history') {
    conversationHistory.forEach((message, index) => {
      if (!message.content || message.content.trim() === '') {
        valid = false;
        errors.push('empty_content');
      }
      
      if (!message.role || !['user', 'assistant'].includes(message.role)) {
        valid = false;
        errors.push('invalid_role');
      }
      
      if (!message.timestamp || isNaN(Date.parse(message.timestamp))) {
        valid = false;
        errors.push('invalid_timestamp');
      }
    });
  }
  
  if (validationType === 'detection_config') {
    if (!config.enabledDetectors || config.enabledDetectors.length === 0) {
      valid = false;
      errors.push('no_detectors_enabled');
    }
    
    if (config.confidenceThreshold < 0 || config.confidenceThreshold > 1) {
      valid = false;
      errors.push('confidence_threshold_out_of_range');
    }
    
    if (!['strict', 'moderate', 'permissive'].includes(config.privacyLevel)) {
      valid = false;
      errors.push('invalid_privacy_level');
    }
    
    if (typeof config.biasMonitoring !== 'boolean') {
      valid = false;
      errors.push('invalid_bias_monitoring_type');
    }
  }
  
  return {
    valid,
    errors,
    model
  };
}

function calculateMarkerAccuracy(extracted, expected) {
  const intersection = extracted.filter(marker => expected.includes(marker));
  return intersection.length / expected.length;
}