        });
        
        return {
          testCase: testCase.name,
          collaborativeScore: personalityAnalysis.traits.collaborative,
          trustLevel: personalityAnalysis.traits.trusting,
          partnershipOrientation: personalityAnalysis.traits.partnership_oriented,
          decisionMakingStyle: personalityAnalysis.recommendedDecisionMaking,
