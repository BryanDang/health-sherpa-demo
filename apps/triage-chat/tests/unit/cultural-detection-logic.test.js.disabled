      };

      const result = await rateLimitedApiCall(analyticalDetectionTest, 'precision');
      
      expect(result.analyticalScore).toBeGreaterThan(0.7);
      expect(result.detailOrientation).toBeGreaterThan(0.6);
      expect(result.informationDepth).toBe('detailed');
      expect(result.explanationStyle).toBe('technical');
      
    }, 18000);
    
    test('identifies collaborative personality patterns', async () => {
      const collaborativeDetectionTest = async (model) => {
        console.log(`Testing collaborative personality detection using ${model}`);
        
        const testCase = UNIT_TEST_CONFIG.testConversations.personalityTraits[2];
        
        const personalityAnalysis = await mockPersonalityTraitDetection({
          messages: testCase.messages,
