describe('Cultural Detection Logic - Unit Tests', () => {
  
  beforeAll(async () => {
    console.log('Starting Cultural Detection unit tests');
    console.log(`Rate limiter status:`, testRateLimiter.getStatus());
  });

  describe('Cultural Marker Extraction', () => {
    
    test('extracts high-context communication markers', async () => {
      const markerExtractionTest = async (model) => {
        console.log(`Testing high-context communication marker extraction using ${model}`);
        
        const testCase = UNIT_TEST_CONFIG.testConversations.culturalMarkers[0];
        
        const extractionResult = await mockCulturalMarkerExtraction({
          messages: testCase.messages,
          extractionType: 'communication_style',
          model
        });
        
        return {
          testCase: testCase.name,
          extractedMarkers: extractionResult.markers,
          expectedMarkers: testCase.expectedMarkers,
          accuracy: calculateMarkerAccuracy(extractionResult.markers, testCase.expectedMarkers),
          confidence: extractionResult.confidence,
          model
        };
      };

      const result = await rateLimitedApiCall(markerExtractionTest, 'precision');
      
      expect(result.extractedMarkers).toContain('indirect_communication');
      expect(result.extractedMarkers).toContain('family_centered');
      expect(result.accuracy).toBeGreaterThan(0.7);
      expect(result.confidence).toBeGreaterThan(0.6);
      
    }, 20000);
    
    test('extracts traditional health belief markers', async () => {
      const healthBeliefTest = async (model) => {
        console.log(`Testing traditional health belief marker extraction using ${model}`);
        
        const testCase = UNIT_TEST_CONFIG.testConversations.culturalMarkers[2];
        
        const extractionResult = await mockCulturalMarkerExtraction({
          messages: testCase.messages,
          extractionType: 'health_beliefs',
          model
        });
        
        return {
          testCase: testCase.name,
          extractedMarkers: extractionResult.markers,
          expectedMarkers: testCase.expectedMarkers,
          healthBeliefCategory: extractionResult.category,
          accommodationNeeds: extractionResult.accommodations,
          model
        };
      };

      const result = await rateLimitedApiCall(healthBeliefTest, 'precision');
      
      expect(result.extractedMarkers).toContain('traditional_medicine');
      expect(result.healthBeliefCategory).toBe('traditional');
      expect(result.accommodationNeeds).toContain('respect_natural_remedies');
      
    }, 18000);
    
    test('distinguishes between biomedical and traditional orientations', async () => {
      const orientationTest = async (model) => {
        console.log(`Testing biomedical vs traditional orientation detection using ${model}`);
        
        const traditionalCase = UNIT_TEST_CONFIG.testConversations.culturalMarkers[2];
        const biomedicalCase = UNIT_TEST_CONFIG.testConversations.culturalMarkers[3];
        
        const traditionalResult = await mockCulturalMarkerExtraction({
          messages: traditionalCase.messages,
          extractionType: 'health_orientation',
          model
        });
        
        const biomedicalResult = await mockCulturalMarkerExtraction({
          messages: biomedicalCase.messages,
          extractionType: 'health_orientation',
          model
        });
        
        return {
          traditionalOrientation: traditionalResult.orientation,
          biomedicalOrientation: biomedicalResult.orientation,
          orientationDifference: Math.abs(traditionalResult.score - biomedicalResult.score),
          model
        };
      };

      const result = await rateLimitedApiCall(orientationTest, 'precision');
      
      expect(result.traditionalOrientation).toBe('traditional');
      expect(result.biomedicalOrientation).toBe('biomedical');
      expect(result.orientationDifference).toBeGreaterThan(0.5);
      
    }, 25000);
  });

  describe('Communication Style Analysis', () => {
    
    test('analyzes formality levels accurately', async () => {
      const formalityTest = async (model) => {
        console.log(`Testing formality level analysis using ${model}`);
        
        const formalCase = UNIT_TEST_CONFIG.testConversations.communicationStyles[0];
        const informalCase = UNIT_TEST_CONFIG.testConversations.communicationStyles[1];
        
        const formalAnalysis = await mockCommunicationStyleAnalysis({
          messages: formalCase.messages,
          analysisType: 'formality',
          model
        });
        
        const informalAnalysis = await mockCommunicationStyleAnalysis({
          messages: informalCase.messages,
          analysisType: 'formality',
          model
        });
        
        return {
          formalScore: formalAnalysis.formality,
          informalScore: informalAnalysis.formality,
          expectedFormalScore: formalCase.expectedStyle.formality,
          expectedInformalScore: informalCase.expectedStyle.formality,
          formalAccuracy: Math.abs(formalAnalysis.formality - formalCase.expectedStyle.formality),
          informalAccuracy: Math.abs(informalAnalysis.formality - informalCase.expectedStyle.formality),
          model
        };
      };

      const result = await rateLimitedApiCall(formalityTest, 'precision');
      
      expect(result.formalScore).toBeGreaterThan(0.7);
      expect(result.informalScore).toBeLessThan(0.4);
      expect(result.formalAccuracy).toBeLessThan(0.2);
      expect(result.informalAccuracy).toBeLessThan(0.2);
      
    }, 22000);
    
    test('measures directness vs indirectness', async () => {
      const directnessTest = async (model) => {
        console.log(`Testing directness measurement using ${model}`);
        
        const directMessages = UNIT_TEST_CONFIG.testConversations.culturalMarkers[1].messages;
        const indirectMessages = UNIT_TEST_CONFIG.testConversations.culturalMarkers[0].messages;
        
        const directAnalysis = await mockCommunicationStyleAnalysis({
          messages: directMessages,
          analysisType: 'directness',
          model
        });
        
        const indirectAnalysis = await mockCommunicationStyleAnalysis({
          messages: indirectMessages,
          analysisType: 'directness',
          model
        });
        
        return {
          directScore: directAnalysis.directness,
          indirectScore: indirectAnalysis.directness,
          directnessRange: directAnalysis.directness - indirectAnalysis.directness,
          communicationAdaptation: directAnalysis.recommendedAdaptation,
          model
        };
      };

      const result = await rateLimitedApiCall(directnessTest, 'precision');
      
      expect(result.directScore).toBeGreaterThan(0.6);
      expect(result.indirectScore).toBeLessThan(0.5);
      expect(result.directnessRange).toBeGreaterThan(0.3);
      expect(result.communicationAdaptation).toBeDefined();
      
    }, 20000);
    
    test('detects emotional expression patterns', async () => {
      const emotionalExpressionTest = async (model) => {
        console.log(`Testing emotional expression pattern detection using ${model}`);
        
        const emotionalMessages = [
          'I\'m so scared about this diagnosis!',
          'This pain is driving me crazy!',
          'I feel overwhelmed by all these medical terms'
        ];
        
        const reservedMessages = [
          'I have some discomfort in this area',
          'The symptoms are manageable',
          'I would prefer to explore treatment options'
        ];
        
        const emotionalAnalysis = await mockCommunicationStyleAnalysis({
          messages: emotionalMessages,
          analysisType: 'emotional_expression',
          model
        });
        
        const reservedAnalysis = await mockCommunicationStyleAnalysis({
          messages: reservedMessages,
          analysisType: 'emotional_expression',
          model
        });
        
        return {
          emotionalScore: emotionalAnalysis.emotionalExpression,
          reservedScore: reservedAnalysis.emotionalExpression,
          expressionDifference: emotionalAnalysis.emotionalExpression - reservedAnalysis.emotionalExpression,
          supportNeedsEmotional: emotionalAnalysis.supportNeeds,
          supportNeedsReserved: reservedAnalysis.supportNeeds,
          model
        };
      };

      const result = await rateLimitedApiCall(emotionalExpressionTest, 'precision');
      
      expect(result.emotionalScore).toBeGreaterThan(0.7);
      expect(result.reservedScore).toBeLessThan(0.4);
      expect(result.expressionDifference).toBeGreaterThan(0.4);
      expect(result.supportNeedsEmotional).toContain('reassurance');
      
    }, 25000);
  });

  describe('Personality Trait Detection', () => {
    
    test('identifies anxious personality patterns', async () => {
      const anxietyDetectionTest = async (model) => {
        console.log(`Testing anxiety pattern detection using ${model}`);
        
        const testCase = UNIT_TEST_CONFIG.testConversations.personalityTraits[0];
        
