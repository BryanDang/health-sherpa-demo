      const result = await rateLimitedApiCall(anxietyDetectionTest, 'precision');
      
      expect(result.anxietyScore).toBeGreaterThan(0.7);
      expect(result.anxietyIndicators).toContain('catastrophic_thinking');
      expect(result.reassuranceLevel).toBe('high');
      expect(result.communicationAdjustments).toContain('provide_frequent_reassurance');
      
    }, 20000);
    
    test('identifies analytical personality patterns', async () => {
      const analyticalDetectionTest = async (model) => {
        console.log(`Testing analytical personality detection using ${model}`);
        
        const testCase = UNIT_TEST_CONFIG.testConversations.personalityTraits[1];
        
        const personalityAnalysis = await mockPersonalityTraitDetection({
          messages: testCase.messages,
