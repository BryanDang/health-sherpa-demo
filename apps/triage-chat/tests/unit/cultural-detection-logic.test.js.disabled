      expect(result.overallCompliant).toBe(true);
      
    }, 18000);
    
    test('detects consent violations', async () => {
      const consentViolationTest = async (model) => {
        console.log(`Testing consent violation detection using ${model}`);
        
        const testCase = UNIT_TEST_CONFIG.privacyTestCases[2];
        
        const privacyValidation = await mockPrivacyComplianceValidation({
          culturalData: testCase.culturalData,
          regulation: testCase.regulation,
