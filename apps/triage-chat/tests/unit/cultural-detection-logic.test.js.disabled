/**
 * Unit Tests: Cultural Detection & Personality Adaptation Logic
 * 
 * Tests individual functions and components in isolation:
 * - Cultural marker extraction
 * - Communication style analysis
 * - Personality trait detection
 * - Bias monitoring algorithms
 * - Privacy compliance validation
 * 
 * Following TDD + Contract-Driven Development protocol
 */

import { describe, test, expect, beforeAll, afterEach } from '@jest/globals';
import { testRateLimiter, rateLimitedApiCall } from '../utils/multi-model-rate-limiter';

// Test configuration for unit testing
const UNIT_TEST_CONFIG = {
  // Sample conversation data for testing
  testConversations: {
    culturalMarkers: [
      {
        name: 'high_context_communication',
        messages: [
          'I hope you understand what I mean',
          'My family will be very disappointed if this doesn\'t work',
          'We need to consider what the community will think'
        ],
        expectedMarkers: ['indirect_communication', 'family_centered', 'community_oriented']
      },
      {
        name: 'low_context_communication', 
        messages: [
          'I need antibiotics for my infection',
          'What exactly is the cost?',
          'When can I schedule the appointment?'
        ],
        expectedMarkers: ['direct_communication', 'task_oriented', 'individual_focused']
      },
      {
        name: 'traditional_health_beliefs',
        messages: [
          'I prefer natural remedies first',
          'My grandmother always used herbal tea for this',
          'Traditional medicine has worked for generations'
        ],
        expectedMarkers: ['traditional_medicine', 'generational_wisdom', 'natural_healing']
      },
      {
        name: 'biomedical_orientation',
        messages: [
          'What does the research say about this treatment?',
          'I want the most effective medication available',
          'Can you show me the clinical trial data?'
        ],
        expectedMarkers: ['evidence_based', 'scientific_approach', 'data_driven']
      }
    ],
    
    personalityTraits: [
      {
        name: 'anxious_personality',
        messages: [
          'I\'m really worried this could be something serious',
          'What if the treatment doesn\'t work?',
          'I can\'t stop thinking about worst-case scenarios'
        ],
        expectedTraits: ['high_anxiety', 'catastrophic_thinking', 'need_reassurance']
      },
      {
        name: 'analytical_personality',
        messages: [
          'Let me understand the mechanism of action',
          'What are all the possible side effects?',
          'I\'d like to research this before deciding'
        ],
        expectedTraits: ['analytical', 'detail_oriented', 'research_focused']
      },
      {
        name: 'collaborative_personality',
        messages: [
          'What do you think would be best?',
          'I trust your professional judgment',
          'Let\'s work together on this plan'
        ],
        expectedTraits: ['collaborative', 'trusting', 'partnership_oriented']
      }
    ],
    
    communicationStyles: [
      {
        name: 'formal_style',
        messages: [
          'Good morning, I would like to discuss my medical concerns',
          'Thank you for your professional assistance',
          'I appreciate your expertise in this matter'
        ],
        expectedStyle: {
          formality: 0.9,
          directness: 0.7,
          emotionalExpression: 0.3
        }
      },
      {
        name: 'informal_style',
        messages: [
          'Hey, so I\'ve been feeling kinda crappy lately',
          'This pain is really bumming me out',
          'Thanks for helping me figure this out!'
        ],
        expectedStyle: {
          formality: 0.2,
          directness: 0.8,
          emotionalExpression: 0.7
        }
      }
    ]
  },
  
  // Bias detection test cases
  biasTestCases: [
    {
      name: 'stereotypical_assumption',
      culturalProfile: {
        detectedCultures: [{ culture: 'Latino', confidence: 0.95, evidence: ['speaks_spanish'] }],
        assumptions: ['large_family', 'catholic', 'traditional_gender_roles']
      },
      expectedBiasRisk: 'high'
    },
    {
      name: 'evidence_based_detection',
      culturalProfile: {
        detectedCultures: [{ culture: 'East_Asian', confidence: 0.75, evidence: ['family_decision_making', 'respect_for_authority', 'indirect_communication'] }],
        assumptions: []
      },
      expectedBiasRisk: 'low'
    }
  ],
  
  // Privacy validation test cases
  privacyTestCases: [
    {
      name: 'gdpr_compliance',
      culturalData: {
        sensitiveCategories: ['ethnicity', 'religion'],
        consentStatus: true,
