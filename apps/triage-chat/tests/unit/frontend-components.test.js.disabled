/**
 * Unit Tests: Frontend Components - Medical Markdown & Internal Thoughts
 * 
 * Tests the new UI components with medical-specific rendering
 * Following TDD + Contract-Driven Development
 */

import { describe, test, expect, beforeEach } from '@jest/globals';

// Mock React components for testing
const MockReact = {
  createElement: (type, props, ...children) => ({ type, props, children }),
  Children: {
    toArray: (children) => Array.isArray(children) ? children : [children]
  }
};

// Mock Zustand store for testing
const mockStore = {
  currentResponse: null,
  conversationHistory: [],
  debugMode: false,
  userStatus: {
    emergency_assessment: {
      level: 'routine',
      confidence: 'high',
      red_flags: [],
      escalation_needed: false
    },
    medical_context: {
      primary_concern: 'headache',
      symptoms_reported: ['headache', 'mild pain'],
      duration: '2 days',
      severity_scale: 3,
      relevant_history: []
    },
    session_context: {
      conversation_stage: 'assessment',
      questions_asked: 2,
      tools_used: []
    }
  },
  actions: {
    sendMessage: jest.fn(),
    toggleDebugMode: jest.fn(),
    updateUserStatus: jest.fn()
  }
};

// Mock triage response for testing
const mockTriageResponse = {
  user_message: "# Assessment Results \n\nBased on your **headache** symptoms, this appears to be a routine concern.\n\n**My recommendations:**\n• Monitor symptoms for changes\n• Consider over-the-counter relief\n• Schedule primary care if worsening\n\n> **Note**: This is general guidance. Seek immediate care for severe symptoms.",
  
  internal_thoughts: {
    medical_reasoning: {
      symptom_analysis: "Patient reports mild headaches over 2 days, no red flag symptoms present",
      differential_considerations: ["tension headache", "stress-related", "dehydration"],
      severity_assessment: "Low severity, routine care appropriate",
      emergency_protocol_triggered: false
    },
    cultural_assessment: {
      cultural_indicators_detected: ["direct communication style"],
      communication_style_preference: "straightforward medical information",
      personality_adaptation_needed: "maintain professional but warm tone"
    },
    tool_usage: {
      tools_considered: ["google_maps_healthcare_search", "advanced_pricing_analysis"],
      tool_selected: "google_maps_healthcare_search",
      reason_for_selection: "User may need provider recommendations",
      parameters_used: { location: { zipCode: "32801" }, facilityTypes: ["primary_care"] },
      results_summary: "Found 5 primary care providers within 5 miles"
    },
    response_strategy: {
      communication_approach: "provide clear actionable guidance",
      information_depth: "routine_300_words",
      follow_up_questions: ["symptom progression", "care preferences"],
      markdown_formatting_plan: "use headers and bullet points for clarity"
    },
    continuity_check: {
      conversation_context_maintained: true,
      user_status_updates: ["updated symptom timeline", "assessed severity"],
      next_interaction_preparation: "ready for follow-up questions about care options"
    }
  },
  
  user_status: {
    emergency_assessment: {
      level: "routine",
      confidence: "high", 
      red_flags: [],
      escalation_needed: false
    },
    medical_context: {
      primary_concern: "headache",
      symptoms_reported: ["headache", "mild pain"],
      duration: "2 days",
      severity_scale: 3,
      relevant_history: []
    },
    session_context: {
      conversation_stage: "assessment",
      questions_asked: 2,
      tools_used: ["google_maps_healthcare_search"]
    }
  }
};

describe('Medical Markdown Component', () => {
  
  describe('Content Rendering', () => {
    test('renders basic markdown with medical styling', () => {
      const content = "# Symptoms \n\nYou have **mild symptoms** that require *routine care*.";
      
      const result = renderMedicalMarkdown({
        content,
        variant: 'routine',
        enableSymptomHighlighting: true
      });
      
      expect(result.success).toBe(true);
      expect(result.containsHeaders).toBe(true);
      expect(result.containsSymptomHighlighting).toBe(true);
      expect(result.variant).toBe('routine');
    });

    test('detects and highlights emergency content', () => {
      const emergencyContent = "**EMERGENCY**: Call 911 immediately for chest pain and difficulty breathing.";
      
      const result = renderMedicalMarkdown({
        content: emergencyContent,
        variant: 'emergency',
        enableEmergencyAlerts: true
      });
      
      expect(result.success).toBe(true);
      expect(result.emergencyDetected).toBe(true);
      expect(result.hasEmergencyAlert).toBe(true);
      expect(result.variant).toBe('emergency');
    });

    test('renders provider cards correctly', () => {
      const providerData = {
        name: "Orlando Regional Medical Center",
        distance: 2.3,
        rating: 4.2,
        priceLevel: "PRICE_LEVEL_MODERATE",
        openNow: true
      };
      
      const result = renderProviderCard(providerData);
      
      expect(result.success).toBe(true);
      expect(result.showsDistance).toBe(true);
      expect(result.showsRating).toBe(true);
      expect(result.showsPricing).toBe(true);
      expect(result.showsAvailability).toBe(true);
    });

    test('renders symptom severity scale', () => {
      const severityData = {
        severity: 6,
        maxScale: 10
      };
      
      const result = renderSymptomSeverityScale(severityData);
      
      expect(result.success).toBe(true);
      expect(result.percentage).toBe(60);
      expect(result.colorClass).toContain('yellow'); // 6/10 should be yellow warning
      expect(result.showsScale).toBe(true);
    });
  });

  describe('Medical Context Detection', () => {
    test('identifies medical terms and symptoms', () => {
      const medicalContent = "Patient has hypertension and reports chest pain with shortness of breath.";
      
      const analysis = analyzeMedicalContent(medicalContent);
      
      expect(analysis.medicalTerms).toContain('hypertension');
      expect(analysis.symptoms).toContain('chest pain');
      expect(analysis.emergencyIndicators).toContain('shortness of breath');
      expect(analysis.requiresHighlighting).toBe(true);
    });

    test('detects pricing and location context', () => {
      const locationContent = "Find urgent care near 32801 with cash prices under $200.";
      
      const analysis = analyzeMedicalContent(locationContent);
      
      expect(analysis.hasLocationContext).toBe(true);
      expect(analysis.hasPricingContext).toBe(true);
      expect(analysis.facilityType).toBe('urgent_care');
    });
  });

  describe('Icon Assignment', () => {
    test('assigns appropriate icons to medical headings', () => {
      const testCases = [
        { text: "Emergency Action Required ", expectedIcon: "AlertTriangle" },
        { text: "Cost Information ", expectedIcon: "DollarSign" },
        { text: "Nearby Providers ", expectedIcon: "MapPin" },
        { text: "Contact Information ", expectedIcon: "Phone" },
        { text: "Assessment Results ", expectedIcon: "Heart" }
      ];
      
      testCases.forEach(({ text, expectedIcon }) => {
        const result = getHeadingIcon(text, 'routine');
        expect(result.iconType).toBe(expectedIcon);
      });
    });
  });
});

describe('Internal Thoughts Component', () => {
  
  describe('Collapsible Sections', () => {
    test('renders all thought sections with correct structure', () => {
      const result = renderInternalThoughts({
        thoughts: mockTriageResponse.internal_thoughts,
        debugMode: true
      });
      
      expect(result.success).toBe(true);
      expect(result.sectionsRendered).toBe(5); // medical, cultural, tool, strategy, continuity
      expect(result.allSectionsCollapsible).toBe(true);
      expect(result.hasGlobalToggle).toBe(true);
    });

    test('hides component when debug mode disabled', () => {
      const result = renderInternalThoughts({
        thoughts: mockTriageResponse.internal_thoughts,
        debugMode: false
      });
      
      expect(result.success).toBe(true);
      expect(result.isVisible).toBe(false);
    });

    test('renders medical reasoning section correctly', () => {
      const reasoning = mockTriageResponse.internal_thoughts.medical_reasoning;
      
      const result = renderMedicalReasoningSection(reasoning);
      
      expect(result.success).toBe(true);
      expect(result.showsSymptomAnalysis).toBe(true);
      expect(result.showsDifferentialConsiderations).toBe(true);
      expect(result.showsSeverityAssessment).toBe(true);
      expect(result.showsEmergencyProtocol).toBe(true);
      expect(result.emergencyFlag).toBe(false); // Not emergency in mock
    });

    test('renders cultural assessment section correctly', () => {
      const assessment = mockTriageResponse.internal_thoughts.cultural_assessment;
      
      const result = renderCulturalAssessmentSection(assessment);
      
      expect(result.success).toBe(true);
      expect(result.showsCulturalIndicators).toBe(true);
      expect(result.showsCommunicationStyle).toBe(true);
      expect(result.showsPersonalityAdaptation).toBe(true);
      expect(result.indicatorCount).toBe(1); // "direct communication style"
    });

    test('renders tool usage section when tools used', () => {
      const toolUsage = mockTriageResponse.internal_thoughts.tool_usage;
      
      const result = renderToolUsageSection(toolUsage);
      
      expect(result.success).toBe(true);
      expect(result.showsToolsConsidered).toBe(true);
      expect(result.showsToolSelected).toBe(true);
      expect(result.showsSelectionReasoning).toBe(true);
      expect(result.showsParameters).toBe(true);
      expect(result.showsResults).toBe(true);
      expect(result.selectedTool).toBe('google_maps_healthcare_search');
    });
  });

  describe('Debug Mode Integration', () => {
    test('toggles debug mode correctly', () => {
      const result = testDebugModeToggle({
        initialState: false,
        action: 'toggle'
      });
      
      expect(result.success).toBe(true);
      expect(result.finalState).toBe(true);
      expect(result.internalThoughtsVisible).toBe(true);
    });

    test('shows/hides internal thoughts based on debug mode', () => {
      const result = testInternalThoughtsVisibility({
        debugMode: true,
        showInternalThoughts: true
      });
      
      expect(result.success).toBe(true);
      expect(result.isVisible).toBe(true);
      expect(result.hasToggleButton).toBe(true);
    });
  });
});

describe('Zustand Store Integration', () => {
  
  describe('State Management', () => {
    test('initializes with default state correctly', () => {
      const store = createMockTriageStore();
      
      expect(store.currentResponse).toBeUndefined();
      expect(store.conversationHistory).toHaveLength(0);
      expect(store.debugMode).toBe(false);
      expect(store.userStatus.emergency_assessment.level).toBe('routine');
      expect(store.culturalProfile.communicationStyle).toBe('adaptive');
    });

    test('handles message sending correctly', async () => {
      const store = createMockTriageStore();
      const testMessage = "I have a headache that started 2 days ago";
      
      const result = await store.sendMessage(testMessage);
      
      expect(result.success).toBe(true);
      expect(store.conversationHistory).toHaveLength(1);
      expect(store.conversationHistory[0].role).toBe('user');
      expect(store.conversationHistory[0].content).toBe(testMessage);
      expect(store.totalMessages).toBe(1);
    });

    test('updates user status from response', () => {
      const store = createMockTriageStore();
      
      store.addResponse(mockTriageResponse);
      
      expect(store.currentResponse).toBeDefined();
      expect(store.userStatus.emergency_assessment.level).toBe('routine');
      expect(store.userStatus.session_context.tools_used).toContain('google_maps_healthcare_search');
      expect(store.conversationHistory).toHaveLength(1);
    });

    test('handles emergency mode activation', () => {
      const store = createMockTriageStore();
      
      store.activateEmergencyMode('emergency', ['chest pain', 'difficulty breathing']);
      
      expect(store.emergencyState.active).toBe(true);
      expect(store.emergencyState.level).toBe('emergency');
      expect(store.emergencyState.redFlags).toContain('chest pain');
      expect(store.emergencyState.escalationRecommended).toBe(true);
    });

    test('tracks cultural profile updates', () => {
      const store = createMockTriageStore();
      
      store.updateCulturalProfile({
        indicators: ['spanish_language', 'family_oriented'],
        communicationStyle: 'warm_personal',
        confidenceLevel: 'high'
      });
      
      expect(store.culturalProfile.indicators).toContain('spanish_language');
      expect(store.culturalProfile.communicationStyle).toBe('warm_personal');
      expect(store.culturalProfile.confidenceLevel).toBe('high');
    });
  });

  describe('Tool Integration Tracking', () => {
    test('records tool usage correctly', () => {
      const store = createMockTriageStore();
      
      store.recordToolUsage('google_maps_healthcare_search');
      store.recordToolUsage('advanced_pricing_analysis');
      
      expect(store.toolsUsed).toContain('google_maps_healthcare_search');
      expect(store.toolsUsed).toContain('advanced_pricing_analysis');
      expect(store.providerSearchPerformed).toBe(true);
      expect(store.pricingDataRetrieved).toBe(true);
    });

    test('tracks location searches', () => {
      const store = createMockTriageStore();
      
      store.updateLocationSearch({
        zipCode: '32801',
        coordinates: { latitude: 28.5383, longitude: -81.3792 }
      });
      
      expect(store.lastLocationSearch).toBeDefined();
      expect(store.lastLocationSearch.zipCode).toBe('32801');
      expect(store.lastLocationSearch.coordinates.latitude).toBe(28.5383);
    });
  });

  describe('Session Management', () => {
    test('exports session data correctly', async () => {
      const store = createMockTriageStore();
      store.conversationHistory = [
        { role: 'user', content: 'test message', timestamp: '2024-01-01T00:00:00Z', message_id: 'msg1' }
      ];
      
      const sessionData = await store.exportSession();
      const parsed = JSON.parse(sessionData);
      
      expect(parsed.sessionId).toBeDefined();
      expect(parsed.conversationHistory).toHaveLength(1);
      expect(parsed.exportedAt).toBeDefined();
    });

    test('imports session data correctly', () => {
      const store = createMockTriageStore();
      const sessionData = JSON.stringify({
        sessionId: 'test-session',
        conversationHistory: [
          { role: 'user', content: 'imported message', timestamp: '2024-01-01T00:00:00Z' }
        ],
        userStatus: mockTriageResponse.user_status
      });
      
      store.importSession(sessionData);
      
      expect(store.sessionId).toBe('test-session');
      expect(store.conversationHistory).toHaveLength(1);
      expect(store.conversationHistory[0].content).toBe('imported message');
    });
  });
});

// Mock functions for testing

function renderMedicalMarkdown({ content, variant, enableSymptomHighlighting, enableEmergencyAlerts }) {
  // Simulate medical markdown rendering
  const hasEmergencyPatterns = /EMERGENCY|CALL 911/gi.test(content);
  const hasSymptoms = /headache|pain|fever|nausea/gi.test(content);
  const hasHeaders = /^#/m.test(content);
  
  return {
    success: true,
    containsHeaders: hasHeaders,
    containsSymptomHighlighting: enableSymptomHighlighting && hasSymptoms,
    emergencyDetected: hasEmergencyPatterns,
    hasEmergencyAlert: enableEmergencyAlerts && hasEmergencyPatterns,
    variant
  };
}

function renderProviderCard({ name, distance, rating, priceLevel, openNow }) {
  return {
    success: true,
    showsDistance: distance !== undefined,
    showsRating: rating !== undefined,
    showsPricing: priceLevel !== undefined,
    showsAvailability: openNow !== undefined
  };
}

function renderSymptomSeverityScale({ severity, maxScale }) {
  const percentage = (severity / maxScale) * 100;
  const colorClass = severity <= 3 ? 'green' : severity <= 6 ? 'yellow' : severity <= 8 ? 'orange' : 'red';
  
  return {
    success: true,
    percentage,
    colorClass,
    showsScale: true
  };
}

function analyzeMedicalContent(content) {
  const medicalTerms = content.match(/hypertension|diabetes|asthma|medication/gi) || [];
  const symptoms = content.match(/chest pain|headache|fever|nausea|shortness of breath/gi) || [];
  const emergencyIndicators = content.match(/chest pain|shortness of breath|difficulty breathing/gi) || [];
  const hasLocationContext = /\d{5}|near|location|zip/gi.test(content);
  const hasPricingContext = /\$|price|cost|cash|affordable/gi.test(content);
  const facilityType = content.match(/urgent care|hospital|clinic|pharmacy/gi)?.[0]?.replace(' ', '_');
  
  return {
    medicalTerms,
    symptoms,
    emergencyIndicators,
    requiresHighlighting: symptoms.length > 0,
    hasLocationContext,
    hasPricingContext,
    facilityType
  };
}

function getHeadingIcon(text, variant) {
  const lowerText = text.toLowerCase();
  
  if (lowerText.includes('emergency')) {
    return { iconType: 'AlertTriangle' };
  } else if (lowerText.includes('cost')) {
    return { iconType: 'DollarSign' };
  } else if (lowerText.includes('location')) {
    return { iconType: 'MapPin' };
  } else if (lowerText.includes('call')) {
    return { iconType: 'Phone' };
  } else if (lowerText.includes('assessment')) {
    return { iconType: 'Heart' };
  }
  
  return { iconType: null };
}

function renderInternalThoughts({ thoughts, debugMode }) {
  if (!debugMode) {
    return { success: true, isVisible: false };
  }
  
  return {
    success: true,
    isVisible: true,
    sectionsRendered: 5,
    allSectionsCollapsible: true,
    hasGlobalToggle: true
  };
}

function renderMedicalReasoningSection(reasoning) {
  return {
    success: true,
    showsSymptomAnalysis: !!reasoning.symptom_analysis,
    showsDifferentialConsiderations: reasoning.differential_considerations?.length > 0,
    showsSeverityAssessment: !!reasoning.severity_assessment,
    showsEmergencyProtocol: true,
    emergencyFlag: reasoning.emergency_protocol_triggered
  };
}

function renderCulturalAssessmentSection(assessment) {
  return {
    success: true,
    showsCulturalIndicators: assessment.cultural_indicators_detected?.length > 0,
    showsCommunicationStyle: !!assessment.communication_style_preference,
    showsPersonalityAdaptation: !!assessment.personality_adaptation_needed,
    indicatorCount: assessment.cultural_indicators_detected?.length || 0
  };
}

function renderToolUsageSection(toolUsage) {
  return {
    success: true,
    showsToolsConsidered: toolUsage.tools_considered?.length > 0,
    showsToolSelected: !!toolUsage.tool_selected,
    showsSelectionReasoning: !!toolUsage.reason_for_selection,
    showsParameters: !!toolUsage.parameters_used,
    showsResults: !!toolUsage.results_summary,
    selectedTool: toolUsage.tool_selected
  };
}

function testDebugModeToggle({ initialState, action }) {
  let debugMode = initialState;
  
  if (action === 'toggle') {
    debugMode = !debugMode;
  }
  
  return {
    success: true,
    finalState: debugMode,
    internalThoughtsVisible: debugMode
  };
}

function testInternalThoughtsVisibility({ debugMode, showInternalThoughts }) {
  return {
    success: true,
    isVisible: debugMode && showInternalThoughts,
    hasToggleButton: true
  };
}

function createMockTriageStore() {
  return {
    currentResponse: undefined,
    conversationHistory: [],
    isLoading: false,
    error: undefined,
    userStatus: {
      emergency_assessment: { level: 'routine', confidence: 'medium', red_flags: [], escalation_needed: false },
      medical_context: { primary_concern: '', symptoms_reported: [], duration: '', severity_scale: 1, relevant_history: [] },
      session_context: { conversation_stage: 'initial', questions_asked: 0, tools_used: [], provider_search_performed: false, pricing_data_retrieved: false }
    },
    debugMode: false,
    showInternalThoughts: false,
    totalMessages: 0,
    toolsUsed: [],
    providerSearchPerformed: false,
    pricingDataRetrieved: false,
    culturalProfile: { indicators: [], communicationStyle: 'adaptive', personalityAdaptation: 'neutral', confidenceLevel: 'medium' },
    emergencyState: { active: false, redFlags: [], escalationRecommended: false },
    
    // Actions
    sendMessage: async (message) => {
      const userMessage = { role: 'user', content: message, timestamp: new Date().toISOString(), message_id: 'test-msg' };
      mockStore.conversationHistory.push(userMessage);
      mockStore.totalMessages++;
      return { success: true };
    },
    
    addResponse: (response) => {
      mockStore.currentResponse = response;
      mockStore.userStatus = response.user_status;
      mockStore.conversationHistory.push({
        role: 'assistant',
        content: response.user_message,
        timestamp: new Date().toISOString(),
        message_id: 'test-response'
      });
    },
    
    activateEmergencyMode: (level, redFlags) => {
      mockStore.emergencyState = { active: true, level, redFlags, escalationRecommended: level === 'emergency' };
    },
    
    updateCulturalProfile: (updates) => {
      mockStore.culturalProfile = { ...mockStore.culturalProfile, ...updates };
    },
    
    recordToolUsage: (toolName) => {
      mockStore.toolsUsed.push(toolName);
      mockStore.providerSearchPerformed = mockStore.providerSearchPerformed || toolName.includes('maps');
      mockStore.pricingDataRetrieved = mockStore.pricingDataRetrieved || toolName.includes('pricing');
    },
    
    updateLocationSearch: (location) => {
      mockStore.lastLocationSearch = { ...location, timestamp: new Date().toISOString() };
    },
    
    exportSession: async () => {
      return JSON.stringify({
        sessionId: mockStore.sessionId || 'test-session',
        conversationHistory: mockStore.conversationHistory,
        exportedAt: new Date().toISOString()
      });
    },
    
    importSession: (sessionData) => {
      const data = JSON.parse(sessionData);
      mockStore.sessionId = data.sessionId;
      mockStore.conversationHistory = data.conversationHistory || [];
      mockStore.userStatus = data.userStatus || mockStore.userStatus;
    }
  };
}