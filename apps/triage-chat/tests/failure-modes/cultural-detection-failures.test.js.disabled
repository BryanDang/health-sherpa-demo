async function mockMedicalCulturalConflictDetection({ conversationHistory, medicalRecommendation, urgencyLevel, model }) {
  await new Promise(resolve => setTimeout(resolve, 200));
  
  const culturalKeywords = ['traditional', 'herbal', 'religious', 'family'];
  const medicalKeywords = ['antibiotic', 'surgery', 'transfusion', 'emergency'];
  
  const culturalPreference = conversationHistory.some(msg => 
    culturalKeywords.some(keyword => msg.content.toLowerCase().includes(keyword))
  );
  
  const medicalIntervention = medicalKeywords.some(keyword => 
    medicalRecommendation.toLowerCase().includes(keyword)
  );
  
  const conflictDetected = culturalPreference && medicalIntervention;
  
  return {
    conflictDetected,
    conflict: conflictDetected ? {
      culturalBelief: 'traditional_medicine_only',
      medicalRecommendation,
      urgencyLevel,
      severity: 'high'
    } : null,
    model
  };
}

async function mockMedicalSafetyPrioritization({ conflict, urgencyLevel, model }) {
  await new Promise(resolve => setTimeout(resolve, 150));
  
  const prioritizeSafety = conflict && (urgencyLevel === 'emergency' || urgencyLevel === 'urgent');
  
  return {
    medicalSafetyPrioritized: prioritizeSafety,
    culturalExplanationProvided: prioritizeSafety,
    alternativesOffered: prioritizeSafety,
    model
  };
}

async function mockEscalationDecision({ conflict, urgencyLevel, resolutionAttempts, model }) {
  await new Promise(resolve => setTimeout(resolve, 100));
  
  const conflictUnresolvable = conflict && resolutionAttempts >= 3;
  const escalationTriggered = conflictUnresolvable && urgencyLevel === 'emergency';
  
  return {
    conflictUnresolvable,
    escalationTriggered,
    humanProviderContacted: escalationTriggered,
    emergencyProtocolActivated: escalationTriggered,
    model
  };
}

async function mockCulturalDetectionWithTimeout({ conversationHistory, timeoutThreshold, model }) {
  await new Promise(resolve => setTimeout(resolve, timeoutThreshold + 1000)); // Simulate timeout
  
  return {
    culturalProfile: null, // Timeout occurred
    processingTime: timeoutThreshold + 1000,
    model
  };
}

async function mockTimeoutHandling({ processingTime, timeoutThreshold, model }) {
  await new Promise(resolve => setTimeout(resolve, 50));
  
  const timeoutDetected = processingTime > timeoutThreshold;
  
  return {
    timeoutDetected,
    fallbackActivated: timeoutDetected,
    simplifiedDetectionUsed: timeoutDetected,
    model
  };
}

async function mockLowConfidenceHandling({ confidenceScore, threshold, model }) {
  await new Promise(resolve => setTimeout(resolve, 50));
  
  const lowConfidenceDetected = confidenceScore < threshold;
  
  return {
    lowConfidenceDetected,
    cachedProfilesUsed: lowConfidenceDetected,
    gracefulDegradation: lowConfidenceDetected,
    model
  };
}