  const respectPrivacy = privacyPreferences.includes('no_cultural_profiling');
  
  return {
    culturalProfilingDisabled: respectPrivacy,
    dataCollectionStopped: respectPrivacy,
    userNotified: respectPrivacy,
    model
  };
}

