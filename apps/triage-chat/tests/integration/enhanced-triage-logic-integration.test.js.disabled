    }
  ]
};

describe('Enhanced Triage Logic - Integration Tests', () => {
  
  beforeAll(async () => {
    console.log('Starting Enhanced Triage Logic integration tests');
    console.log(`Rate limiter status:`, testRateLimiter.getStatus());
  });

  describe('Complete User Journey Integration', () => {
    
    test('handles anxious patient with traditional beliefs', async () => {
      const anxiousTraditionalJourneyTest = async (model) => {
        console.log(`Testing anxious traditional patient journey using ${model}`);
        
        const scenario = INTEGRATION_TEST_CONFIG.userJourneyScenarios[0];
        
        // Step 1: Cultural Detection
        const culturalDetection = await mockCulturalDetectionPipeline({
          conversationHistory: generateConversationHistory(scenario),
          userProfile: scenario.userProfile,
          model
        });
        
        // Step 2: Medical Assessment with Cultural Context
        const medicalAssessment = await mockEnhancedMedicalAssessment({
          medicalInput: scenario.medicalScenario,
          culturalContext: culturalDetection.culturalProfile,
          personalityContext: culturalDetection.personalityProfile,
          model
        });
        
        // Step 3: Tool Integration
        const toolIntegration = await mockMCPToolIntegration({
          assessment: medicalAssessment,
          culturalContext: culturalDetection.culturalProfile,
          userLocation: scenario.userProfile.demographics.location,
          model
        });
        
        // Step 4: Response Generation
        const responseGeneration = await mockCulturallyAdaptedResponse({
          assessment: medicalAssessment,
          culturalAdaptations: culturalDetection.adaptationStrategy,
          toolResults: toolIntegration.toolResults,
          model
        });
        
        return {
          scenario: scenario.name,
          culturalDetectionSuccess: culturalDetection.success,
          personalityDetectionSuccess: culturalDetection.personalityProfile.traits.length > 0,
          medicalAssessmentQuality: medicalAssessment.quality,
          toolsUsedCount: toolIntegration.toolsUsed.length,
          culturalAdaptationsApplied: responseGeneration.adaptationsApplied,
          communicationStyleMatched: responseGeneration.communicationStyle === scenario.expectedOutcome.communicationStyle,
          anxietyMitigated: responseGeneration.anxietyMitigationStrategies.length > 0,
          traditionalBeliefsRespected: responseGeneration.traditionalBeliefsAccommodated,
          model
        };
      };

      const result = await rateLimitedApiCall(anxiousTraditionalJourneyTest, 'precision');
      
      expect(result.culturalDetectionSuccess).toBe(true);
      expect(result.personalityDetectionSuccess).toBe(true);
      expect(result.medicalAssessmentQuality).toBeGreaterThan(0.8);
      expect(result.toolsUsedCount).toBeGreaterThanOrEqual(2);
      expect(result.culturalAdaptationsApplied).toBe(true);
      expect(result.anxietyMitigated).toBe(true);
      expect(result.traditionalBeliefsRespected).toBe(true);
      
    }, 45000);
    
    test('handles emergency scenario with cultural sensitivity', async () => {
      const emergencyCulturalTest = async (model) => {
        console.log(`Testing emergency scenario with cultural sensitivity using ${model}`);
        
        const scenario = INTEGRATION_TEST_CONFIG.userJourneyScenarios[1];
        
        // Step 1: Emergency Detection Pipeline
        const emergencyDetection = await mockEmergencyDetectionPipeline({
          symptoms: scenario.medicalScenario.symptoms,
          severity: scenario.medicalScenario.severity,
          duration: scenario.medicalScenario.duration,
          model
        });
        
        // Step 2: Cultural Context with Emergency Priority
        const culturalEmergencyIntegration = await mockCulturalEmergencyIntegration({
          emergencyLevel: emergencyDetection.emergencyLevel,
          culturalContext: scenario.userProfile.culturalMarkers,
          personalityContext: scenario.userProfile.personalityTraits,
          model
        });
        
        // Step 3: Emergency Response with Cultural Adaptations
        const emergencyResponse = await mockEmergencyResponseGeneration({
          emergencyDetection,
          culturalIntegration: culturalEmergencyIntegration,
          communicationStyle: scenario.userProfile.communicationStyle,
          model
        });
        
        return {
          scenario: scenario.name,
          emergencyDetected: emergencyDetection.emergencyLevel === 'emergency',
          culturalSensitivityMaintained: culturalEmergencyIntegration.culturalSensitivityMaintained,
          directCommunicationUsed: emergencyResponse.communicationStyle.includes('direct'),
          technicalExplanationsProvided: emergencyResponse.explanationStyle === 'technical',
          immediateActionRecommended: emergencyResponse.immediateAction === 'call_911_recommendation',
          culturalAdaptationsPreserved: culturalEmergencyIntegration.adaptationsPreserved,
          model
        };
      };

      const result = await rateLimitedApiCall(emergencyCulturalTest, 'precision');
      
      expect(result.emergencyDetected).toBe(true);
      expect(result.culturalSensitivityMaintained).toBe(true);
      expect(result.directCommunicationUsed).toBe(true);
      expect(result.immediateActionRecommended).toBe(true);
      expect(result.culturalAdaptationsPreserved).toBe(true);
      
    }, 40000);
    
    test('handles collaborative family-oriented patient', async () => {
      const collaborativeFamilyTest = async (model) => {
        console.log(`‍‍‍Testing collaborative family-oriented patient using ${model}`);
        
        const scenario = INTEGRATION_TEST_CONFIG.userJourneyScenarios[2];
        
        // Step 1: Collaborative Communication Detection
        const collaborativeDetection = await mockCollaborativeCommunicationDetection({
          conversationHistory: generateConversationHistory(scenario),
          personalityTraits: scenario.userProfile.personalityTraits,
          model
        });
        
        // Step 2: Family-Centered Cultural Analysis
        const familyCenteredAnalysis = await mockFamilyCenteredAnalysis({
          culturalMarkers: scenario.userProfile.culturalMarkers,
          communicationStyle: scenario.userProfile.communicationStyle,
          model
        });
        
        // Step 3: Collaborative Medical Assessment
        const collaborativeAssessment = await mockCollaborativeMedicalAssessment({
          medicalInput: scenario.medicalScenario,
          collaborativeContext: collaborativeDetection,
          familyContext: familyCenteredAnalysis,
          model
        });
        
        // Step 4: Supportive Response Generation
        const supportiveResponse = await mockSupportiveResponseGeneration({
          assessment: collaborativeAssessment,
          collaborativeStyle: collaborativeDetection.communicationPreferences,
          familyInvolvement: familyCenteredAnalysis.familyInvolvementLevel,
          model
        });
        
        return {
          scenario: scenario.name,
          collaborativeStyleDetected: collaborativeDetection.collaborativeScore > 0.7,
          familyCenteredApproach: familyCenteredAnalysis.familyCenteredScore > 0.7,
          sharedDecisionMakingOffered: supportiveResponse.sharedDecisionMaking,
          familyInvolvementOptions: supportiveResponse.familyInvolvementOptions.length > 0,
          supportiveTone: supportiveResponse.tone === 'supportive',
          warmCommunication: supportiveResponse.warmth > 0.7,
          model
        };
      };

      const result = await rateLimitedApiCall(collaborativeFamilyTest, 'precision');
      
      expect(result.collaborativeStyleDetected).toBe(true);
      expect(result.familyCenteredApproach).toBe(true);
      expect(result.sharedDecisionMakingOffered).toBe(true);
      expect(result.familyInvolvementOptions).toBe(true);
      expect(result.supportiveTone).toBe(true);
      
    }, 35000);
  });

  describe('MCP Tool Integration with Cultural Context', () => {
    
    test('integrates pricing analysis with cultural cost consciousness', async () => {
      const pricingCulturalIntegrationTest = async (model) => {
        console.log(`Testing pricing-cultural integration using ${model}`);
        
        const scenario = INTEGRATION_TEST_CONFIG.toolIntegrationScenarios[0];
        
        // Step 1: Cultural Cost Consciousness Detection
        const costConsciousnessAnalysis = await mockCostConsciousnessAnalysis({
          culturalContext: scenario.scenario.culturalContext,
          personalityContext: scenario.scenario.personalityContext,
          model
        });
        
        // Step 2: MCP Tool Orchestration
        const toolOrchestration = await mockMCPToolOrchestration({
          userLocation: scenario.scenario.userLocation,
          symptoms: scenario.scenario.symptoms,
          culturalContext: costConsciousnessAnalysis,
          expectedTools: scenario.expectedTools,
          model
        });
        
        // Step 3: Culturally-Adapted Pricing Presentation
        const pricingPresentation = await mockCulturalPricingPresentation({
          pricingData: toolOrchestration.pricingResults,
          culturalAdaptations: costConsciousnessAnalysis.adaptations,
          anxietyMitigation: costConsciousnessAnalysis.anxietyMitigationNeeds,
          model
        });
        
        return {
          scenario: scenario.name,
          toolsUsed: toolOrchestration.toolsUsed,
          expectedToolsUsed: scenario.expectedTools,
          costConsciousnessDetected: costConsciousnessAnalysis.costConsciousnessLevel > 0.7,
          affordableOptionsHighlighted: pricingPresentation.affordableOptionsHighlighted,
          anxietyMitigatingPresentation: pricingPresentation.anxietyMitigating,
          culturallyAppropriatePricing: pricingPresentation.culturallyAppropriate,
          paymentOptionsProvided: pricingPresentation.paymentOptionsProvided,
          model
        };
      };

      const result = await rateLimitedApiCall(pricingCulturalIntegrationTest, 'precision');
      
      expect(result.toolsUsed).toEqual(expect.arrayContaining(result.expectedToolsUsed));
      expect(result.costConsciousnessDetected).toBe(true);
      expect(result.affordableOptionsHighlighted).toBe(true);
      expect(result.anxietyMitigatingPresentation).toBe(true);
      expect(result.culturallyAppropriatePricing).toBe(true);
      
    }, 40000);
    
    test('handles emergency tool integration with family decision-making culture', async () => {
      const emergencyFamilyIntegrationTest = async (model) => {
        console.log(`‍‍‍Testing emergency-family integration using ${model}`);
        
        const scenario = INTEGRATION_TEST_CONFIG.toolIntegrationScenarios[1];
        
        // Step 1: Emergency Detection with Cultural Context
        const emergencyCulturalDetection = await mockEmergencyCulturalDetection({
          symptoms: scenario.scenario.symptoms,
          culturalContext: scenario.scenario.culturalContext,
          personalityContext: scenario.scenario.personalityContext,
          model
        });
        
        // Step 2: Emergency Tool Activation
        const emergencyToolActivation = await mockEmergencyToolActivation({
          emergencyLevel: emergencyCulturalDetection.emergencyLevel,
          userLocation: scenario.scenario.userLocation,
          culturalConsiderations: emergencyCulturalDetection.culturalConsiderations,
          model
        });
        
        // Step 3: Family-Sensitive Emergency Communication
        const familySensitiveEmergencyComm = await mockFamilySensitiveEmergencyCommunication({
          emergencyRecommendations: emergencyToolActivation.recommendations,
          familyDecisionMakingImportance: emergencyCulturalDetection.familyDecisionMakingImportance,
          collaborativeSupport: emergencyCulturalDetection.collaborativeSupportNeeds,
          model
        });
        
        return {
          scenario: scenario.name,
          emergencyDetected: emergencyCulturalDetection.emergencyLevel === 'emergency',
          emergencyPrioritized: emergencyToolActivation.emergencyPrioritized,
          culturalSensitivityMaintained: familySensitiveEmergencyComm.culturalSensitivityMaintained,
          familyInvolvementAcknowledged: familySensitiveEmergencyComm.familyInvolvementAcknowledged,
          collaborativeSupportProvided: familySensitiveEmergencyComm.collaborativeSupportProvided,
          immediateActionBalanced: familySensitiveEmergencyComm.immediateActionBalanced,
          model
        };
      };

      const result = await rateLimitedApiCall(emergencyFamilyIntegrationTest, 'precision');
      
      expect(result.emergencyDetected).toBe(true);
      expect(result.emergencyPrioritized).toBe(true);
      expect(result.culturalSensitivityMaintained).toBe(true);
      expect(result.familyInvolvementAcknowledged).toBe(true);
      expect(result.collaborativeSupportProvided).toBe(true);
      
    }, 35000);
  });

  describe('Cross-System Privacy and Bias Integration', () => {
    
    test('maintains privacy compliance during cultural profiling', async () => {
      const privacyComplianceIntegrationTest = async (model) => {
        console.log(`Testing privacy compliance integration using ${model}`);
        
        const scenario = INTEGRATION_TEST_CONFIG.crossSystemScenarios[0];
        
        // Step 1: Privacy-Aware Cultural Detection
        const privacyAwareCulturalDetection = await mockPrivacyAwareCulturalDetection({
          userConsent: scenario.scenario.userConsent,
          gdprApplicable: scenario.scenario.gdprApplicable,
          sensitiveDataDetected: scenario.scenario.sensitiveDataDetected,
          model
        });
        
        // Step 2: Compliance Validation Pipeline
        const complianceValidation = await mockComplianceValidationPipeline({
          culturalDetectionResult: privacyAwareCulturalDetection,
          regulatoryRequirements: ['GDPR', 'HIPAA'],
          model
        });
        
        // Step 3: Privacy-Compliant Data Processing
        const privacyCompliantProcessing = await mockPrivacyCompliantProcessing({
          culturalData: privacyAwareCulturalDetection.culturalData,
          complianceRequirements: complianceValidation.requirements,
          model
        });
        
        return {
          scenario: scenario.scenario,
          privacyCompliant: complianceValidation.compliant,
          culturalDetectionEnabled: privacyAwareCulturalDetection.detectionEnabled,
          dataMinimized: privacyCompliantProcessing.dataMinimized,
          auditTrailCreated: privacyCompliantProcessing.auditTrail !== null,
          consentRespected: privacyAwareCulturalDetection.consentRespected,
          sensitiveDataProtected: privacyCompliantProcessing.sensitiveDataProtected,
          model
        };
      };

      const result = await rateLimitedApiCall(privacyComplianceIntegrationTest, 'precision');
      
      expect(result.privacyCompliant).toBe(true);
      expect(result.culturalDetectionEnabled).toBe(true);
      expect(result.dataMinimized).toBe(true);
      expect(result.auditTrailCreated).toBe(true);
      expect(result.consentRespected).toBe(true);
      expect(result.sensitiveDataProtected).toBe(true);
      
    }, 30000);
    
    test('detects and corrects cultural bias in real-time', async () => {
      const biasDetectionCorrectionTest = async (model) => {
        console.log(`Testing bias detection and correction using ${model}`);
        
        const scenario = INTEGRATION_TEST_CONFIG.crossSystemScenarios[1];
        
        // Step 1: Bias Detection Pipeline
        const biasDetectionPipeline = await mockBiasDetectionPipeline({
          culturalStereotyping: scenario.scenario.culturalStereotyping,
          biasRisk: scenario.scenario.biasRisk,
          model
        });
        
        // Step 2: User Feedback Integration
        const userFeedbackIntegration = await mockUserFeedbackIntegration({
          biasDetection: biasDetectionPipeline,
          userFeedback: scenario.scenario.userFeedback,
          model
        });
        
        // Step 3: Cultural Correction Application
        const culturalCorrection = await mockCulturalCorrectionApplication({
          biasDetection: biasDetectionPipeline,
          userFeedback: userFeedbackIntegration,
          model
        });
        
        return {
          scenario: scenario.scenario,
          biasDetected: biasDetectionPipeline.biasDetected,
          culturalCorrectionApplied: culturalCorrection.correctionApplied,
          userFeedbackIncorporated: userFeedbackIntegration.feedbackIncorporated,
          fallbackToNeutral: culturalCorrection.fallbackActivated,
          biasLearningUpdated: culturalCorrection.learningSystemUpdated,
          futurePreventionImplemented: culturalCorrection.futurePreventionImplemented,
          model
        };
      };

      const result = await rateLimitedApiCall(biasDetectionCorrectionTest, 'precision');
      
      expect(result.biasDetected).toBe(true);
      expect(result.culturalCorrectionApplied).toBe(true);
      expect(result.userFeedbackIncorporated).toBe(true);
      expect(result.fallbackToNeutral).toBe(true);
      expect(result.biasLearningUpdated).toBe(true);
      
    }, 35000);
  });

  describe('End-to-End System Performance', () => {
    
    test('validates complete pipeline performance under load', async () => {
      const performanceTest = async (model) => {
        console.log(`Testing complete pipeline performance using ${model}`);
        
        // Simulate multiple concurrent cultural detection requests
        const concurrentRequests = Array(5).fill(null).map((_, index) => 
          mockConcurrentCulturalDetection({
            requestId: index,
            userScenario: INTEGRATION_TEST_CONFIG.userJourneyScenarios[index % 3],
            model
          })
        );
        
        const startTime = Date.now();
        const results = await Promise.all(concurrentRequests);
        const totalTime = Date.now() - startTime;
        
        const performanceMetrics = await mockPerformanceMetricsAnalysis({
          results,
          totalTime,
          expectedMaxTime: 15000, // 15 seconds for 5 concurrent requests
          model
        });
        
        return {
          concurrentRequestsHandled: results.length,
          totalProcessingTime: totalTime,
          averageRequestTime: totalTime / results.length,
          allRequestsSuccessful: results.every(r => r.success),
          performanceAcceptable: performanceMetrics.performanceAcceptable,
          memoryUsageAcceptable: performanceMetrics.memoryUsageAcceptable,
          errorRate: performanceMetrics.errorRate,
          model
        };
      };

      const result = await rateLimitedApiCall(performanceTest, 'speed');
      
      expect(result.concurrentRequestsHandled).toBe(5);
      expect(result.allRequestsSuccessful).toBe(true);
      expect(result.averageRequestTime).toBeLessThan(5000); // 5 seconds per request
      expect(result.performanceAcceptable).toBe(true);
      expect(result.errorRate).toBeLessThan(0.1); // Less than 10% error rate
      
    }, 60000);
  });
});

// Mock implementation functions for integration testing

async function mockCulturalDetectionPipeline({ conversationHistory, userProfile, model }) {
  await new Promise(resolve => setTimeout(resolve, 300));
  
  const culturalProfile = {
    detectedCultures: [
      { culture: 'Traditional', confidence: 0.8, evidence: ['traditional_medicine', 'family_decision_making'] }
    ],
    communicationStyle: {
      directness: 0.3,
      formality: 0.8,
      emotionalExpression: 0.4
    },
    healthBeliefs: [
      { category: 'traditional', impact: 'high', accommodations: ['respect_natural_remedies'] }
    ]
  };
  
  const personalityProfile = {
    traits: [
      { trait: 'anxious', score: 0.8 },
      { trait: 'detail_oriented', score: 0.7 }
    ],
    preferredCommunicationStyle: {
      informationDepth: 'detailed',
      reassuranceLevel: 'high'
    }
  };
  
  const adaptationStrategy = {
    communicationAdjustments: ['gentle_explanations', 'frequent_reassurance'],
    culturalAccommodations: ['respect_traditional_views', 'family_involvement']
  };
  
  return {
    success: true,
    culturalProfile,
    personalityProfile,
    adaptationStrategy,
    model
  };
}

async function mockEnhancedMedicalAssessment({ medicalInput, culturalContext, personalityContext, model }) {
  await new Promise(resolve => setTimeout(resolve, 400));
  
  const assessment = {
    emergencyLevel: medicalInput.urgencyLevel,
    assessment: 'Comprehensive medical assessment adapted for cultural context',
    recommendations: ['seek_urgent_care', 'consider_traditional_integrative_approach'],
    culturalConsiderations: ['respect_traditional_beliefs', 'involve_family_in_decisions'],
    personalityAdaptations: ['provide_detailed_explanations', 'offer_frequent_reassurance']
  };
  
  return {
    assessment,
    quality: 0.9,
    culturallyAdapted: true,
    personalityAdapted: true,
    model
  };
}

async function mockMCPToolIntegration({ assessment, culturalContext, userLocation, model }) {
  await new Promise(resolve => setTimeout(resolve, 250));
  
  const toolResults = {
    geocoding: { coordinates: { lat: 28.5383, lng: -81.3792 } },
    providerSearch: {
      providers: [
        { name: 'Community Health Center', affordability: 'low_cost', culturalCompetency: 'high' }
      ]
    },
    pricingAnalysis: {
      affordableOptions: [
        { provider: 'Community Health Center', cost: 150, paymentPlans: true }
      ]
    }
  };
  
  return {
    toolsUsed: ['geocode', 'provider_search', 'pricing_analysis'],
    toolResults,
    culturallyFiltered: true,
    model
  };
}

async function mockCulturallyAdaptedResponse({ assessment, culturalAdaptations, toolResults, model }) {
  await new Promise(resolve => setTimeout(resolve, 200));
  
  return {
    adaptationsApplied: true,
    communicationStyle: 'gentle_detailed_explanations',
    anxietyMitigationStrategies: ['reassurance', 'step_by_step_guidance'],
    traditionalBeliefsAccommodated: true,
    responseQuality: 0.9,
    model
  };
}

async function mockEmergencyDetectionPipeline({ symptoms, severity, duration, model }) {
  await new Promise(resolve => setTimeout(resolve, 150));
  
  const emergencyKeywords = ['chest_pain', 'shortness_of_breath'];
  const isEmergency = symptoms.some(symptom => emergencyKeywords.some(keyword => symptom.includes(keyword)));
  
  return {
    emergencyLevel: isEmergency ? 'emergency' : 'routine',
    emergencyScore: isEmergency ? 0.95 : 0.1,
    immediateAction: isEmergency ? 'call_911' : 'schedule_appointment',
    model
  };
}

async function mockCulturalEmergencyIntegration({ emergencyLevel, culturalContext, personalityContext, model }) {
  await new Promise(resolve => setTimeout(resolve, 100));
  
  return {
    culturalSensitivityMaintained: true,
    adaptationsPreserved: emergencyLevel !== 'emergency' || culturalContext.includes('collaborative'),
    emergencyPriorityRespected: true,
    model
  };
}

async function mockEmergencyResponseGeneration({ emergencyDetection, culturalIntegration, communicationStyle, model }) {
  await new Promise(resolve => setTimeout(resolve, 120));
  
  return {
    communicationStyle: communicationStyle.includes('direct') ? 'direct_technical' : 'gentle_clear',
    explanationStyle: 'technical',
    immediateAction: 'call_911_recommendation',
    culturalRespect: culturalIntegration.culturalSensitivityMaintained,
    model
  };
}

function generateConversationHistory(scenario) {
  return [
    {
      role: 'user',
      content: 'I have been having headaches and my family is concerned',
      timestamp: new Date().toISOString()
    },
    {
      role: 'assistant', 
      content: 'I understand your family\'s concern. Can you tell me more about these headaches?',
      timestamp: new Date().toISOString()
    }
  ];
}

async function mockCollaborativeCommunicationDetection({ conversationHistory, personalityTraits, model }) {
  await new Promise(resolve => setTimeout(resolve, 150));
  
  return {
    collaborativeScore: 0.8,
    communicationPreferences: ['shared_decision_making', 'collaborative_planning'],
    trustLevel: 0.7,
    model
  };
