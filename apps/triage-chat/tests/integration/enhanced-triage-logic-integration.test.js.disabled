async function mockConcurrentCulturalDetection({ requestId, userScenario, model }) {
  await new Promise(resolve => setTimeout(resolve, Math.random() * 2000 + 1000)); // 1-3 second delay
  
  return {
    requestId,
    success: Math.random() > 0.1, // 90% success rate
    processingTime: Math.random() * 2000 + 1000,
    culturalDetectionComplete: true,
    model
  };
}

async function mockPerformanceMetricsAnalysis({ results, totalTime, expectedMaxTime, model }) {
  await new Promise(resolve => setTimeout(resolve, 50));
  
  const successfulResults = results.filter(r => r.success);
  const errorRate = (results.length - successfulResults.length) / results.length;
  
  return {
    performanceAcceptable: totalTime < expectedMaxTime,
    memoryUsageAcceptable: true, // Simulated
    errorRate,
    avgProcessingTime: totalTime / results.length,
    model
  };
}