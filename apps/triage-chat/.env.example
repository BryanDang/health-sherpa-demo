# Demo mode is the default. Nothing here is needed to run `npm run dev`.
# The live backend is not tested here.

# Set to "live" to use the live implementation. Anything else uses the mock.
BACKEND_MODE=mock

# Live only: LLM.
GOOGLE_GENAI_API_KEY=your-key-here

# Live only: geocoding.
GOOGLE_MAPS_API_KEY=your-key-here

# Live only: price data (the source this was written against is retired).
SNOWFLAKE_API_TOKEN=your-token-here
SNOWFLAKE_ACCOUNT_URL=https://your-account.example.com

# Live only: Supabase client used by the older chat component.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Disabled integration tests and supabase/functions examples read these.
SUPABASE_FUNCTIONS_URL=https://your-project.example.com/functions/v1
SUPABASE_ANON_KEY=your-anon-key-here

# Live only: origin allowed by the edge functions (CORS).
ALLOWED_ORIGIN=http://localhost:3001

# Live only: requests per minute per client address.
LIVE_RATE_LIMIT_PER_MINUTE=20
